# Salin file ini menjadi .env lalu sesuaikan nilainya.
PORT=3001
NODE_ENV=development

# PostgreSQL (cocok dengan docker-compose.dev.yml di root repo)
DATABASE_URL="postgresql://lms:lms_password@localhost:5432/lms_db?schema=public"

# Wajib minimal 32 karakter. Buat acak, mis: openssl rand -base64 48
JWT_SECRET="ganti-dengan-string-acak-minimal-32-karakter-yang-panjang"
# Masa berlaku token (detik). 86400 = 1 hari. Dipakai juga untuk umur cookie.
JWT_EXPIRES_IN_SECONDS=86400

# Isi true saat sudah HTTPS (production). Saat dev di http://localhost harus false.
COOKIE_SECURE=false

# Origin frontend untuk CORS (dev). Di production lewat Nginx tidak diperlukan.
FRONTEND_ORIGIN=http://localhost:3001

# Isi true jika backend berjalan di belakang Nginx/reverse proxy (production)
TRUST_PROXY=false

# Akun awal untuk seed
SEED_ADMIN_EMAIL=admin@lms.test
SEED_ADMIN_PASSWORD=Admin12345
